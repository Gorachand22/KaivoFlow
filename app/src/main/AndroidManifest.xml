<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Networking for HTTP / AI / SaaS Steps. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Optional, capability-gated permissions for the phone-native Sparks and Device Steps.
         None are requested at first launch; a Flow asks only when the user adds that Step. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Run bookkeeping across restarts and OEM battery killers. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- The Always-On Engine is one foreground service of type specialUse (no timeout, allowed to start at boot on
         targetSdk 35+). dataSync is gone: it has a 6 hour cap per day and may not start from BOOT_COMPLETED. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Exact-alarm permissions are declared per distribution flavour (src/sideload, src/play):
         sideload holds USE_EXACT_ALARM and SCHEDULE_EXACT_ALARM, play holds only SCHEDULE_EXACT_ALARM.
         See docs/specs/P2-always-on-engine.md section 3.12. -->

    <!-- SMS permissions and the SMS receiver are declared only by the sideload flavour (src/sideload): Play restricts the
         SMS group. The play flavour removes them explicitly (src/play), so no dependency can bring them back. -->

    <!-- Reading notifications is a Settings grant, not a runtime one; the service below is the only user. -->
    <uses-permission android:name="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
        tools:ignore="ProtectedPermissions" />

    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.camera.flash" android:required="false" />
    <uses-feature android:name="android.hardware.wifi" android:required="false" />

    <application
        android:name=".KaivoApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:largeHeap="false"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.KaivoFlow"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.KaivoFlow">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Share sheet: "Share to KaivoFlow" is a Spark. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Notification Spark source. Not exported; bound by the system only. -->
        <service
            android:name="com.kaivoflow.feature.permissions.KaivoNotificationListener"
            android:exported="false"
            android:label="@string/notification_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <receiver
            android:name="com.kaivoflow.core.work.BootReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
        </receiver>

        <!-- Geofence transitions. Not exported: the PendingIntents from GeofencingClient and the proximity-alert fallback
             target this component explicitly. -->
        <receiver
            android:name="com.kaivoflow.core.work.alwayson.GeofenceReceiver"
            android:exported="false"
            android:enabled="true" />

        <!-- Bluetooth ACL connect and disconnect (AO-14). Exported because the Bluetooth stack is the sender; both actions are
             protected broadcasts, so no other app can send them. Whether the platform delivers them to a manifest receiver for the
             target SDK is checked per device (T-BT); the Engine also registers the same receiver logic while it runs, and the
             Inbox dedupe key absorbs a double delivery. -->
        <receiver
            android:name="com.kaivoflow.core.work.alwayson.BluetoothAclReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
                <action android:name="android.bluetooth.device.action.ACL_DISCONNECTED" />
            </intent-filter>
        </receiver>

        <!-- WorkManager is initialised by KaivoApplication through the Hilt worker factory. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- The Always-On Engine (spec 3.4): the only long-lived component. Sticky, survives swipe from Recents on stock
             Android (stopWithTask=false), hosts the Inbox consumer and the webhook listener. The subtype text is what the
             property is for: a specific, honest description of the special use. -->
        <service
            android:name="com.kaivoflow.core.work.alwayson.AlwaysOnService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="On-device automation engine that hosts the webhook listener, event receivers and scheduled Run executor for Flows the user has published." />
        </service>

        <!-- WorkManager promotes long jobs through its own service. Use the same type as the Engine, so a chatty Flow can never
             consume a dataSync budget (spec 3.4). tools:replace overrides the type WorkManager's library manifest declares. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="specialUse"
            tools:node="merge"
            tools:replace="android:foregroundServiceType">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Runs a published automation Flow that outlasts WorkManager's normal job time when the always-on engine cannot start." />
        </service>

        <!-- Every alarm the Engine sets (schedule slots, Pulse, restart). Not exported: PendingIntents target it explicitly. -->
        <receiver
            android:name="com.kaivoflow.core.work.alwayson.AlarmReceiver"
            android:exported="false" />

        <!-- Sent by the system to apps holding SCHEDULE_EXACT_ALARM when the user grants or revokes it (API 31+).
             exported=false still receives it: it comes from a privileged system component. -->
        <receiver
            android:name="com.kaivoflow.core.work.alwayson.ExactAlarmPermissionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>

    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="sms" />
        </intent>
    </queries>
</manifest>
