<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Play flavour: only SCHEDULE_EXACT_ALARM, which the user grants in Settings. USE_EXACT_ALARM
         is reserved for alarm-clock and calendar apps (spec section 9). -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- The SMS group is Play-restricted. The Play build has no SMS Spark: it declares no SMS permission and no SMS receiver, and
         these removals keep a library manifest from adding one back. -->
    <uses-permission android:name="android.permission.READ_SMS" tools:node="remove" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" tools:node="remove" />
    <uses-permission android:name="android.permission.SEND_SMS" tools:node="remove" />

    <application>
        <receiver android:name="com.kaivoflow.feature.permissions.SmsSparkReceiver" tools:node="remove" />
    </application>
</manifest>
